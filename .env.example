# חיבור ל-Postgres (ב-Vercel: נוצר אוטומטית כשמחברים Neon מה-Marketplace)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# סוד לחתימת עוגיות סשן — מחרוזת אקראית ארוכה (למשל: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# קוד ההצטרפות שחברי המדור מזינים בהרשמה
JOIN_CODE=change-me
